# Semantic Talent Engine — Environment Configuration
# Copy this file to .env and fill in your values
# cp .env.example .env

# AI Provider: "openai" or "ollama"
AI_PROVIDER_TYPE=openai

# Model name (used when AI_PROVIDER_TYPE=openai)
MODEL_NAME=gpt-4o-mini

# OpenAI API key (required when AI_PROVIDER_TYPE=openai)
OPENAI_API_KEY=your-api-key-here

# Debug mode: True enables verbose telemetry and preserves temp images
DEBUG_MODE=True

# --- Dashboard authentication (REQUIRED) ---
# Signing key for session tokens. There is NO default on purpose: a key written
# in the source would be published with the repository, and anyone reading it
# could mint a valid token and bypass the login form entirely.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# Session lifetime in hours.
JWT_HORAS_VALIDEZ=8

# Initial recruiter account. If the password is left blank, a random one is
# generated on first run and printed to the console exactly once.
ADMIN_INICIAL_USUARIO=admin
ADMIN_INICIAL_PASSWORD=

# Failed-login lockout: attempts allowed per user, and how long the block lasts.
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MINUTOS=15

# Where the recruiter accounts live. Defaults to <project>/storage/usuarios.db
# USUARIOS_DB_PATH=
