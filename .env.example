# Semantic Talent Engine — Environment Configuration
# Copy this file to .env and fill in your values
# cp .env.example .env

# AI Provider: "openai" or "ollama"
AI_PROVIDER_TYPE=openai

# Model name (used when AI_PROVIDER_TYPE=openai)
MODEL_NAME=gpt-4o-mini

# OpenAI API key (required when AI_PROVIDER_TYPE=openai)
OPENAI_API_KEY=your-api-key-here

# Debug mode: True enables verbose telemetry and preserves temp images
DEBUG_MODE=True

# --- Email alerts (optional) ---
# Gmail account for sending talent alerts. Leave blank to disable.
EMAIL_SENDER_USER=
EMAIL_SENDER_PASSWORD=
EMAIL_RECRUITER_TARGET=

# --- Security (optional) ---
# Secret key for JWT token signing. Uses a default if not set.
# JWT_SECRET_KEY=
